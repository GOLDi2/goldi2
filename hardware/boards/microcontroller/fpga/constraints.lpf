
###################################################################################################
# General constraints
###################################################################################################
BLOCK ASYNCPATHS ;
BLOCK RESETPATHS ;
FREQUENCY 48.00000 MHz ;



###################################################################################################
# Pin placement contstraints
###################################################################################################
#External clock and reset
IOBUF PORT "ClockFPGA" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "ClockFPGA" SITE "128" ;
IOBUF PORT "FPGA_nReset" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "FPGA_nReset" SITE "126" ;


#SPI communication with RaspberryPie
IOBUF PORT "SPI0_SCLK" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "SPI0_SCLK" SITE "89" ;
IOBUF PORT "SPI0_nCE0" IO_TYPE=LVCMOS33 PULLMODE=UP ;
LOCATE COMP "SPI0_nCE0" SITE "84" ;
IOBUF PORT "SPI1_nCE1" IO_TYPE=LVCMOS33 PULLMODE=UP ;
LOCATE COMP "SPI1_nCE1" SITE "85" ;
IOBUF PORT "SPI0_nCE1" IO_TYPE=LVCMOS33 PULLMODE=UP ;
LOCATE COMP "SPI0_nCE1" SITE "86" ;
IOBUF PORT "SPI0_MOSI" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "SPI0_MOSI" SITE "87" ;
IOBUF PORT "SPI0_MISO" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "SPI0_MISO" SITE "91" ;


IOBUF PORT "LEDPowerG" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "LEDPowerG" SITE "93" ;
IOBUF PORT "LEDPowerR" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "LEDPowerR" SITE "92" ;

IOBUF PORT "GPIO0" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "GPIO0" SITE "50" ;
IOBUF PORT "GPIO1" IO_TYPE=LVCMOS33 PULLMODE=DOWN ;
LOCATE COMP "GPIO1" SITE "52" ;


